# ─── Runtime ────────────────────────────────────────────────────────────────
# Set to "production" on the live server. Enables Sentry, quieter logs, etc.
NODE_ENV=development
PORT=5100

# Set to "true" when running behind nginx / a load balancer so rate limiting
# and logs see the real client IP.
TRUST_PROXY=false

# Comma-separated list of allowed browser origins. "*" allows everything.
# Production example: https://celitetyre.com,https://www.celitetyre.com
CORS_ORIGIN=*

# Max JSON body size (default 1mb)
BODY_LIMIT=1mb

# ─── Database (MySQL) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=celiteTyreDB
DB_POOL_SIZE=10
DB_LOGGING=false

# ─── Admin API ──────────────────────────────────────────────────────────────
# Required for the image-upload / catalogue-write endpoints.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it as the `x-api-key` header.
ADMIN_API_KEY=

# ─── E-mail (Gmail app password) ────────────────────────────────────────────
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
# Where customer inquiries are delivered. Defaults to EMAIL_USER.
ADMIN_EMAIL=owner@yourbusiness.com

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Rate limits ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
INQUIRY_LIMIT_PER_15_MIN=5
UPLOAD_LIMIT_PER_MINUTE=30

# ─── Logging ────────────────────────────────────────────────────────────────
# LOG_DIR=/var/log/celite
# LOG_LEVEL=info
# DETAILED_ACCESS_LOG=true

# ─── Sentry (optional, production only) ─────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Image auto-fill (npm run images -- fill) ─────────────────────────────────
# Google Programmable Search in image mode. Free tier: 100 queries/day.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
